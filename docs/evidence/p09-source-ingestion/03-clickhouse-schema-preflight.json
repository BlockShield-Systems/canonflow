  "create_statements": [
    {
      "database": "canonflow",
      "table": "agent_runs",
      "create_statement": "CREATE TABLE canonflow.agent_runs\n(\n    `run_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `agent_name` LowCardinality(String),\n    `workflow_name` LowCardinality(String),\n    `model_name` LowCardinality(String),\n    `status` LowCardinality(String),\n    `input_summary` String DEFAULT '',\n    `output_summary` String DEFAULT '',\n    `error_message` String DEFAULT '',\n    `started_at` DateTime64(3, 'UTC') DEFAULT now64(3),\n    `completed_at` Nullable(DateTime64(3, 'UTC')),\n    `duration_ms` UInt64 DEFAULT 0,\n    `metadata_json` String DEFAULT '{}'\n)\nENGINE = SharedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')\nORDER BY (project_id, started_at, run_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "canon_entities",
      "create_statement": "CREATE TABLE canonflow.canon_entities\n(\n    `entity_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `entity_type` LowCardinality(String),\n    `canonical_name` String,\n    `aliases` Array(String) DEFAULT [],\n    `description` String DEFAULT '',\n    `attributes_json` String DEFAULT '{}',\n    `source_document_ids` Array(UUID) DEFAULT [],\n    `version` UInt32 DEFAULT 1,\n    `confidence` Float32 DEFAULT 1.,\n    `created_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedReplacingMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}', version)\nORDER BY (project_id, entity_type, entity_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "continuity_findings",
      "create_statement": "CREATE TABLE canonflow.continuity_findings\n(\n    `finding_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `scene_id` Nullable(UUID),\n    `shot_id` Nullable(UUID),\n    `severity` LowCardinality(String),\n    `category` LowCardinality(String),\n    `description` String,\n    `evidence_json` String DEFAULT '{}',\n    `recommendation` String DEFAULT '',\n    `status` LowCardinality(String) DEFAULT 'open',\n    `detected_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')\nORDER BY (project_id, detected_at, finding_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "media_assets",
      "create_statement": "CREATE TABLE canonflow.media_assets\n(\n    `asset_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `scene_id` Nullable(UUID),\n    `shot_id` Nullable(UUID),\n    `asset_type` LowCardinality(String),\n    `generation_provider` LowCardinality(String),\n    `model_name` LowCardinality(String),\n    `storage_uri` String,\n    `mime_type` LowCardinality(String),\n    `checksum_sha256` String DEFAULT '',\n    `duration_ms` UInt64 DEFAULT 0,\n    `width` UInt32 DEFAULT 0,\n    `height` UInt32 DEFAULT 0,\n    `prompt` String DEFAULT '',\n    `metadata_json` String DEFAULT '{}',\n    `created_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')\nORDER BY (project_id, asset_type, created_at, asset_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "projects",
      "create_statement": "CREATE TABLE canonflow.projects\n(\n    `project_id` UUID DEFAULT generateUUIDv4(),\n    `slug` LowCardinality(String),\n    `title` String,\n    `description` String DEFAULT '',\n    `language` LowCardinality(String) DEFAULT 'en',\n    `status` LowCardinality(String) DEFAULT 'development',\n    `metadata_json` String DEFAULT '{}',\n    `created_at` DateTime64(3, 'UTC') DEFAULT now64(3),\n    `updated_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedReplacingMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}', updated_at)\nORDER BY project_id\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "scenes",
      "create_statement": "CREATE TABLE canonflow.scenes\n(\n    `scene_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `scene_number` UInt32,\n    `title` String,\n    `synopsis` String DEFAULT '',\n    `location_entity_id` Nullable(UUID),\n    `time_of_day` LowCardinality(String) DEFAULT '',\n    `character_entity_ids` Array(UUID) DEFAULT [],\n    `story_beats` Array(String) DEFAULT [],\n    `continuity_requirements` Array(String) DEFAULT [],\n    `version` UInt32 DEFAULT 1,\n    `metadata_json` String DEFAULT '{}',\n    `created_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedReplacingMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}', version)\nORDER BY (project_id, scene_number, scene_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "shot_specs",
      "create_statement": "CREATE TABLE canonflow.shot_specs\n(\n    `shot_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `scene_id` UUID,\n    `shot_number` UInt32,\n    `shot_type` LowCardinality(String),\n    `duration_ms` UInt32,\n    `description` String,\n    `camera_movement` String DEFAULT '',\n    `lens` String DEFAULT '',\n    `visual_prompt` String DEFAULT '',\n    `negative_prompt` String DEFAULT '',\n    `dialogue` String DEFAULT '',\n    `sound_design` String DEFAULT '',\n    `continuity_constraints` Array(String) DEFAULT [],\n    `status` LowCardinality(String) DEFAULT 'planned',\n    `version` UInt32 DEFAULT 1,\n    `metadata_json` String DEFAULT '{}',\n    `created_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedReplacingMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}', version)\nORDER BY (project_id, scene_id, shot_number, shot_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "source_documents",
      "create_statement": "CREATE TABLE canonflow.source_documents\n(\n    `document_id` UUID DEFAULT generateUUIDv4(),\n    `project_id` UUID,\n    `file_name` String,\n    `source_path` String DEFAULT '',\n    `content_type` LowCardinality(String),\n    `checksum_sha256` FixedString(64),\n    `content` String,\n    `metadata_json` String DEFAULT '{}',\n    `ingested_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')\nORDER BY (project_id, document_id)\nSETTINGS index_granularity = 8192"
    },
    {
      "database": "canonflow",
      "table": "tool_events",
      "create_statement": "CREATE TABLE canonflow.tool_events\n(\n    `event_id` UUID DEFAULT generateUUIDv4(),\n    `run_id` UUID,\n    `project_id` UUID,\n    `tool_name` LowCardinality(String),\n    `operation` LowCardinality(String),\n    `success` Bool,\n    `request_json` String DEFAULT '{}',\n    `response_summary` String DEFAULT '',\n    `error_message` String DEFAULT '',\n    `duration_ms` UInt64 DEFAULT 0,\n    `occurred_at` DateTime64(3, 'UTC') DEFAULT now64(3)\n)\nENGINE = SharedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')\nORDER BY (project_id, occurred_at, event_id)\nSETTINGS index_granularity = 8192"
    }
  ]
}
